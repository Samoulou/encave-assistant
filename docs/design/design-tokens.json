{
  "meta": {
    "name": "EnCave Assistant",
    "version": "1.0.0",
    "status": "design-baseline-not-implemented",
    "date": "2026-09-07",
    "colorSpace": "sRGB",
    "units": "CSS px unless named otherwise",
    "note": "Independent from EnCave marketplace. Colors are a design reference; application accessibility must be checked after implementation."
  },
  "color": {
    "background": "#F8F6F3",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F0EBE7",
    "text": "#272326",
    "textMuted": "#655B62",
    "brand": "#6E2944",
    "brandHover": "#532035",
    "brandSubtle": "#F8EDF1",
    "borderDecorative": "#DDD5D7",
    "borderControl": "#877A80",
    "focus": "#005FCC",
    "success": "#176442",
    "successSubtle": "#EAF5EE",
    "warning": "#7C4A00",
    "warningSubtle": "#FFF2D6",
    "danger": "#A42336",
    "dangerSubtle": "#FCECEF",
    "info": "#235D80",
    "infoSubtle": "#EAF3FA"
  },
  "typography": {
    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "size": {
      "caption": 12,
      "label": 14,
      "body": 16,
      "section": 20,
      "page": 28,
      "display": 36
    },
    "lineHeight": {
      "body": 1.5,
      "heading": 1.2
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "amounts": "tabular-nums"
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "input": 8,
    "button": 8,
    "card": 12,
    "dialog": 16,
    "badge": 999
  },
  "layout": {
    "sidebar": 232,
    "pageMax": 1440,
    "publicFormMax": 640,
    "desktopGutter": 32,
    "mobileGutter": 16,
    "breakpoints": {
      "compact": 640,
      "medium": 960,
      "wide": 1280
    },
    "minViewport": 320
  },
  "size": {
    "controlMinHeight": 44,
    "targetMinWidth": 44,
    "textareaMinHeight": 120,
    "tableRowMinHeight": 64,
    "icon": 20
  },
  "focus": {
    "colorToken": "focus",
    "width": 3,
    "offset": 3,
    "separationColorToken": "surface",
    "note": "Use a white separation ring on filled controls; preserve focus under sticky bars."
  },
  "motion": {
    "fastMs": 120,
    "normalMs": 180,
    "reducedMotionMs": 0,
    "policy": "No automatic animation needed for critical state changes."
  },
  "shadow": {
    "card": "0 2px 8px rgba(39, 35, 38, 0.05)",
    "dialog": "0 12px 40px rgba(39, 35, 38, 0.18)"
  },
